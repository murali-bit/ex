{
  "manifest_version": 3,
  "name": "AOC-4 Auto Filler (Germin8)",
  "version": "1.1.0",
  "description": "Pick a client, click Fill — AOC-4 form auto-populates on MCA.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://www.mca.gov.in/*", "https://*.mca.gov.in/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AOC-4 Auto Filler"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.mca.gov.in/*",
        "https://*.mca.gov.in/*"
      ],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "background": { "service_worker": "background.js" },
  "web_accessible_resources": [
    {
      "resources": [
        "libs/pdf.min.js",
        "libs/pdf.worker.min.js",
        "clients/*.json"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
